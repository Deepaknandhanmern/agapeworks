// Local dev uses SQLite (zero-config, file-based). If this ever deploys to
// serverless hosting (Vercel etc.), swap `provider` to "postgresql", point
// DATABASE_URL at a hosted Postgres (Neon/Vercel Postgres), and swap the
// driver adapter in src/lib/db.ts from @prisma/adapter-better-sqlite3 to
// @prisma/adapter-pg — the schema below deliberately avoids SQLite-only or
// Postgres-only types (no native arrays/enums; tags are stored as a
// JSON-encoded string) so that migration doesn't need a schema rewrite.
//
// Prisma 7 requires a driver adapter at the PrismaClient constructor (see
// src/lib/db.ts) — the datasource block below only configures the CLI
// (migrate/studio), via prisma7.config.ts, not the runtime client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String
  coverImage  String?
  author      String   @default("Agape Works")
  tags        String   @default("[]")
  published   Boolean  @default(true)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  url         String?
  description String
  screenshot  String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Enquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  service     String
  budget      String
  timeline    String
  source      String?
  message     String
  status      String   @default("new")
  // AI triage (best-effort — populated shortly after creation, may stay
  // null if the triage call fails; see src/lib/ai/enquiry-triage.ts).
  priority    String?
  aiSummary   String?
  createdAt   DateTime @default(now())
}

// Active client engagements — distinct from Project (the public portfolio
// showcase). Each one gets a no-login status page at /status/[statusToken]
// so a client can check progress without an account.
model ClientProject {
  id          String   @id @default(cuid())
  projectName String
  clientName  String
  clientEmail String
  // Discovery | Build | QA | Launched — plain string (see the datasource
  // comment above on avoiding native enums).
  phase       String   @default("Discovery")
  statusToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updates     ProjectUpdate[]
  comments    ProjectComment[]
}

// "What shipped this week" entries on a client's status page — posted from
// the dashboard, triggers a best-effort email to the client on creation.
model ProjectUpdate {
  id              String        @id @default(cuid())
  clientProjectId String
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  title           String
  body            String
  createdAt       DateTime      @default(now())
}

// Client feedback left directly on their status page — no login, gated only
// by knowing the unguessable statusToken.
model ProjectComment {
  id              String        @id @default(cuid())
  clientProjectId String
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  authorName      String
  message         String
  createdAt       DateTime      @default(now())
}
