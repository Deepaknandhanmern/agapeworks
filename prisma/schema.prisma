// Hosted Postgres (Supabase) — local SQLite couldn't survive a fresh deploy
// (the file is gitignored and Hostinger rebuilds from a clean clone every
// time). The schema deliberately avoids Postgres-only types (no native
// arrays/enums; tags are stored as a JSON-encoded string) — a holdover from
// when this also had to run on SQLite, kept in case that ever matters again.
//
// Prisma 7 requires a driver adapter at the PrismaClient constructor (see
// src/lib/db.ts, @prisma/adapter-pg) — the datasource block below only
// configures the CLI (migrate/studio), via prisma7.config.ts, not the
// runtime client.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     String
  coverImage  String?
  author      String   @default("Agape Works")
  tags        String   @default("[]")
  published   Boolean  @default(true)
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  url         String?
  description String
  screenshot  String?
  // "project" (default, shown under "Recent projects") or "landing_page"
  // (shown under the portfolio's "Landing Page" section) — plain string
  // rather than a native enum, matching this schema's no-Postgres-enums rule.
  category    String   @default("project")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Footer "Stay Connected" signup (src/components/ui/footer-section.tsx).
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

// Captured before the Vivira WordPress plugin download is allowed to start
// (src/components/sections/vivira-download-button.tsx) — a lightweight lead
// gate, not an account: no password, no session.
model ViviraDownloadLead {
  id        String   @id @default(cuid())
  name      String
  email     String
  createdAt DateTime @default(now())
}

// Uploaded from the admin dashboard (src/app/dashboard/(app)/vivira) -
// append-only history rather than a single mutable row, so past releases
// stay visible/auditable. The live download link always uses whichever row
// has the newest uploadedAt (see getViviraDownloadHref in src/lib/vivira.ts).
model ViviraPluginRelease {
  id          String   @id @default(cuid())
  fileName    String
  storagePath String
  sizeBytes   Int
  uploadedAt  DateTime @default(now())
}

model Enquiry {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  service     String
  budget      String
  timeline    String
  source      String?
  message     String
  status      String   @default("new")
  // AI triage (best-effort — populated shortly after creation, may stay
  // null if the triage call fails; see src/lib/ai/enquiry-triage.ts).
  priority    String?
  aiSummary   String?
  createdAt   DateTime @default(now())
}

// Active client engagements — distinct from Project (the public portfolio
// showcase). Each one gets a no-login status page at /status/[statusToken]
// so a client can check progress without an account.
model ClientProject {
  id          String   @id @default(cuid())
  projectName String
  clientName  String
  clientEmail String
  // Discovery | Build | QA | Launched — plain string (see the datasource
  // comment above on avoiding native enums).
  phase       String   @default("Discovery")
  statusToken String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Set when the client opens /client/[id] in the client portal — compared
  // against the latest update/file createdAt to show an unread indicator on
  // /client. Unrelated to the token-based /status/[token] page, which has
  // no concept of a returning, identified visitor.
  clientLastViewedAt DateTime?
  updates     ProjectUpdate[]
  comments    ProjectComment[]
  files       ProjectFile[]

  // The client portal's primary query (src/lib/data/client-portal.ts) looks
  // up all projects by clientEmail — normalized lowercase on write, so an
  // exact-value index still serves the case-insensitive query.
  @@index([clientEmail])
}

// "What shipped this week" entries on a client's status page — posted from
// the dashboard, triggers a best-effort email to the client on creation.
model ProjectUpdate {
  id              String        @id @default(cuid())
  clientProjectId String
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  title           String
  body            String
  createdAt       DateTime      @default(now())
}

// Client feedback left directly on their status page — no login, gated only
// by knowing the unguessable statusToken.
model ProjectComment {
  id              String        @id @default(cuid())
  clientProjectId String
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  authorName      String
  message         String
  createdAt       DateTime      @default(now())
}

// Admin-uploaded files (invoices, spec sheets, onboarding PDFs) — for
// admin's own reference and the client's reference on their status page.
// Upload/delete is admin-only; the client can only view/download. The
// actual bytes live in Supabase Storage (private bucket) — storagePath is
// the object key there, and download URLs are always freshly signed
// server-side (see src/lib/storage.ts), never stored.
model ProjectFile {
  id              String        @id @default(cuid())
  clientProjectId String
  clientProject   ClientProject @relation(fields: [clientProjectId], references: [id], onDelete: Cascade)
  fileName        String
  storagePath     String
  sizeBytes       Int
  contentType     String
  createdAt       DateTime      @default(now())
}

// --- Vahi (GST billing tool, /vahi) -----------------------------------
// A separate product from the Agape Works site itself. One BillingAccount
// per paying business — accounts are created by admin (see the
// billing-accounts dashboard section) after a sale, not self-signup, so
// there's no public registration flow yet. Each account's data
// (customers/items/invoices) is isolated by accountId; every read/write in
// src/lib/vahi/ must filter or scope by the authenticated account.

model BillingAccount {
  id           String   @id @default(cuid())
  businessName String
  gstNumber    String?
  email        String   @unique
  passwordHash String
  phone        String?
  address      String?
  createdAt    DateTime @default(now())
  customers    BillingCustomer[]
  items        BillingItem[]
  invoices     Invoice[]
}

model BillingCustomer {
  id        String         @id @default(cuid())
  accountId String
  account   BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  email     String?
  address   String?
  createdAt DateTime       @default(now())
  invoices  Invoice[]
}

model BillingItem {
  id        String         @id @default(cuid())
  accountId String
  account   BillingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  rate      Float
  taxRate   Float          @default(18)
  createdAt DateTime       @default(now())
}

model Invoice {
  id            String            @id @default(cuid())
  accountId     String
  account       BillingAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  customerId    String
  customer      BillingCustomer   @relation(fields: [customerId], references: [id])
  invoiceNumber String
  // unpaid | paid — plain string, see the datasource comment at the top of
  // this file on avoiding native enums.
  status        String            @default("unpaid")
  issueDate     DateTime          @default(now())
  dueDate       DateTime?
  notes         String?
  // Gates the public, no-login print/share view at /vahi/invoice/[publicToken]
  // — same capability-URL pattern as ClientProject.statusToken.
  publicToken   String            @unique @default(cuid())
  // Set when an overdue-payment reminder email was last sent — lets both the
  // manual "Send reminder" button and the automated cron endpoint
  // (src/app/api/vahi/send-reminders) avoid re-sending too often.
  remindedAt    DateTime?
  createdAt     DateTime          @default(now())
  lineItems     InvoiceLineItem[]
}

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  name      String
  quantity  Float
  rate      Float
  taxRate   Float
}
